# ── Application Identity ──────────────────────────────────────────────────────
AURORA_APPLICATION_NAME=igot_aurora
AURORA_APPLICATION_ENVIRONMENT=dev   # dev | uat | prod

# ── Server & Host Config ──────────────────────────────────────────────────────
APP_PORT=4020
BASE_URL=http://localhost:4020

# ── LLM Settings (Google Gemini) ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# ── ElasticSearch (Ticket Store, Tracking & Application Logs) ────────────────
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=               # Optional: leave empty if ES has no authentication
ELASTICSEARCH_PASSWORD=               # Optional: leave empty if ES has no authentication

# ElasticSearch Index Bases
ELASTICSEARCH_BOT_INTERACTION_INDEX=agent_interaction
ELASTICSEARCH_LOGS_INDEX=application_logs

# ── iGOT Platform API ─────────────────────────────────────────────────────────
IGOT_KEY=your_igot_api_jwt_key_here
IGOT_API_HOST_URL=https://portal.igotkarmayogi.gov.in

# ── YouTube Data API v3 (event video duration lookup) ─────────────────────────
GOOGLE_YOUTUBE_API_KEY=your_google_youtube_api_key_here
# Base URL without the /videos suffix, e.g. https://www.googleapis.com/youtube/v3
GOOGLE_YOUTUBE_API_BASE_URL=your_youtube_api_base_url_here

# ── Zoho Desk API (Human-in-the-Loop Draft Replies) ───────────────────────────
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORG_ID=your_zoho_org_id_here
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_DESK_URL=https://desk.zoho.in
ZOHO_FROM_ADDRESS=mission.karmayogi@gov.in

# ── Apache Kafka (Asynchronous Resolution Worker Queue) ───────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=resolution_tickets
KAFKA_GROUP_ID=aurora_resolution_workers

# ── Feature Flags ─────────────────────────────────────────────────────────────
VALIDATE_EMAIL=false
RESTRICT_TO_EMAIL_CHANNEL=false
ENABLE_ZOHO_TICKET_UPDATE=true


