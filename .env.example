
AURORA_APPLICATION_NAME=igot_aurora
AURORA_APPLICATION_ENVIRONMENT=dev   # dev | staging | prod

# ── Server ────────────────────────────────────────────────────────────────────
APP_PORT=4020
BASE_URL=http://localhost:4020        

# ── LLM — Google Gemini ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── ElasticSearch (Primary Database: Ticket Store, Tracking & Analytics) ──────
ELASTICSEARCH_HOST=https://your-es-host:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_es_password

# ElasticSearch Index Names
ELASTICSEARCH_BOT_INTERACTION_INDEX=agent_interaction
ELASTICSEARCH_LOGS_INDEX=application_logs

# ── iGOT Platform API ─────────────────────────────────────────────────────────
# JWT token used by resolution tools to call iGOT APIs on behalf of the agent.
IGOT_KEY=eyxxxxxxxxxxxxxxxxxxxx
IGOT_API_HOST_URL=https://portal.uat.karmayogibharat.net

# ── Zoho Desk API (Optional Integration) ──────────────────────────────────────
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORG_ID=your_zoho_org_id_here
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_DESK_URL=https://desk.zoho.in

# ── Apache Kafka (Asynchronous Ticket Ingestion Queue) ────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=resolution_tickets
KAFKA_GROUP_ID=aurora_resolution_workers

